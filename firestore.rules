rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Catch-all deny default
    match /{document=**} {
      allow read, write: if false;
    }

    // Schedules collection (inner_jaktim, outer_bekasi)
    match /schedules/{scheduleId} {
      allow read, write: if true;
    }

    // Application Users collection
    match /app_users/{userId} {
      allow read, write: if true;
    }

    // Firestore connection health check
    match /test/connection {
      allow read: if true;
    }
  }
}
